{
  "name": "chatyx",
  "version": "3.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Modern Twitch, YouTube, and Kick chat overlay with multi-platform emote support",
  "type": "module",
  "workspaces": ["services/*"],
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:pages": "vite build && bun scripts/prepare-github-pages.ts",
    "start": "vite preview --host",
    "youtube:dev": "bun run --cwd services/youtube-websocket dev",
    "youtube:start": "bun run --cwd services/youtube-websocket start",
    "sources:dev": "bun run --cwd services/youtube-websocket dev",
    "sources:start": "bun run --cwd services/youtube-websocket start",
    "lint": "bun run lint:app && bun run lint:youtube",
    "lint:app": "oxlint -c ./.oxlintrc.json --tsconfig ./tsconfig.app.json src",
    "lint:youtube": "oxlint -c ./.oxlintrc.json services/youtube-websocket/src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && bun run --cwd services/youtube-websocket typecheck",
    "test": "bun test ./tests",
    "test:services": "bun run --cwd services/youtube-websocket test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run test:services && bun run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "csstype": "^3.2.3",
    "oxlint": "^1.92.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/solid-js": "^1.0.0",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/meta": "^0.29.8",
    "@solidjs/router": "^1.0.1",
    "@zumer/snapdom": "^3.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "solid-js": "^1.9.18",
    "tailwind-merge": "^3.7.0",
    "vanilla-disintegrate": "^1.6.1"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
